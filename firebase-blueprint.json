{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account profile information",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "The Firebase Authentication UID",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "User email address",
          "maxLength": 256
        },
        "displayName": {
          "type": "string",
          "description": "User display name",
          "maxLength": 100
        },
        "photoURL": {
          "type": "string",
          "description": "Profile picture URL",
          "maxLength": 1024
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account registration timestamp"
        }
      },
      "required": ["userId", "email"]
    },
    "SavedProgression": {
      "title": "SavedProgression",
      "description": "User saved scale, chord, or progression bookmark",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "userId": {
          "type": "string",
          "maxLength": 128
        },
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "root": {
          "type": "string",
          "maxLength": 10
        },
        "type": {
          "type": "string",
          "enum": ["scale", "chord"],
          "maxLength": 10
        },
        "name": {
          "type": "string",
          "maxLength": 100
        },
        "notes": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "userId", "title", "root", "type", "name"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores user account profile information"
    },
    "/users/{userId}/savedProgressions/{progressionId}": {
      "schema": {
        "$ref": "#/entities/SavedProgression"
      },
      "description": "Stores user saved chords, scales, and harmonic progressions"
    }
  }
}
