rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User profile validation
    function isValidUser(data, userId) {
      return data.keys().hasAll(['userId', 'email'])
        && data.keys().hasOnly(['userId', 'email', 'displayName', 'photoURL', 'createdAt'])
        && data.userId == userId
        && data.email is string && data.email.size() > 0 && data.email.size() <= 256
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024));
    }

    // Saved Progression validation
    function isValidProgression(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'root', 'type', 'name'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'root', 'type', 'name', 'notes', 'createdAt'])
        && data.userId == userId
        && data.id is string && data.id.size() > 0 && data.id.size() <= 128
        && data.title is string && data.title.size() > 0 && data.title.size() <= 100
        && data.root is string && data.root.size() > 0 && data.root.size() <= 10
        && data.type is string && (data.type == 'scale' || data.type == 'chord')
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 200));
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if false; // Disallow user scraping
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming(), userId)
        && incoming().userId == existing().userId;
      allow delete: if false;

      // User saved progressions subcollection
      match /savedProgressions/{progressionId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(progressionId)
          && isValidProgression(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(progressionId)
          && isValidProgression(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(progressionId);
      }
    }
  }
}
